+// 待机页名牌上的名字。存在设备上而不是编译进固件,所以仓库对任何人都通用,
+// 设备换手也不用重刷 —— 而且插到别的电脑上名字照样在,这是"身份卡"该有的样子。
+// 未设置时返回空串,UI 据此隐藏名牌。
+esp_err_t nvs_settings_get_owner(char *out, size_t cap) {
+    if (!out || cap == 0) return ESP_ERR_INVALID_ARG;
+    out[0] = '\0';
+
+    nvs_handle_t h;
+    if (nvs_open(APP_NS, NVS_READONLY, &h) != ESP_OK) return ESP_OK;   // 无名字即空
+    size_t len = cap;
+    esp_err_t e = nvs_get_str(h, K_OWNER, out, &len);
+    nvs_close(h);
+    if (e != ESP_OK) out[0] = '\0';   // 未设置 / 超长 / 损坏:都按"没名字"处理
+    return ESP_OK;
+}
+
+// 传空串或 NULL 即清除。
+esp_err_t nvs_settings_set_owner(const char *name) {
+    nvs_handle_t h;
+    esp_err_t e = nvs_open(APP_NS, NVS_READWRITE, &h);
+    if (e != ESP_OK) return e;
+
+    if (!name || !name[0]) {
+        e = nvs_erase_key(h, K_OWNER);
+        if (e == ESP_ERR_NVS_NOT_FOUND) e = ESP_OK;   // 本来就没有,视作成功
+    } else {
+        e = nvs_set_str(h, K_OWNER, name);
+    }
+    if (e == ESP_OK) e = nvs_commit(h);
+    nvs_close(h);
+    ESP_LOGI(TAG, "owner = %s", (name && name[0]) ? name : "(cleared)");
+    return e;
+}
