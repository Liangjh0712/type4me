index 822f5e3..6ed81b9 100644
--- a/components/bsp/src/bsp_audio.c
+++ b/components/bsp/src/bsp_audio.c
@@ -155,6 +155,22 @@ esp_err_t bsp_audio_set_format(uint32_t hz, uint8_t bits, uint8_t ch) {
     return ESP_OK;
 }
 
+// 关掉 codec:esp_codec_dev_close → es8311_enable(false) → PA 引脚拉低 +
+// es8311_suspend。这才是"不出声时不耗电"的落点(驱动侧取证:es8311.c 的
+// es8311_enable 在 disable 分支里 set_mute + ES_PA_DISABLE + suspend)。
+esp_err_t bsp_audio_close(void) {
+    if (!s_dev || !s_opened) return ESP_OK;   // 幂等
+    esp_codec_dev_close(s_dev);
+    s_opened = false;
+    // close 把 I2S 通道退回 READY,而下次 open 内部又会 disable 一次 → 会打
+    // "channel has not been enabled yet"。补一次 enable 让它合法(与 set_format
+    // 里同样的处理,原因见那里的注释)。
+    if (s_tx) i2s_channel_enable(s_tx);
+    if (s_rx) i2s_channel_enable(s_rx);
+    ESP_LOGI(TAG, "codec 关闭(PA 断电)");
+    return ESP_OK;
+}
+
 esp_err_t bsp_audio_write(const void *pcm, size_t bytes) {
     if (!s_dev) return ESP_ERR_INVALID_STATE;
     return esp_codec_dev_write(s_dev, (void *)pcm, bytes) == 0 ? ESP_OK : ESP_FAIL;
