+// 12) codec 生命周期(2026-09-02 省电 + 冷启动取舍):开流时 open;stop/cancel
+//     【不】关(重开有几十毫秒冷启动,会吃掉下一句第一个字 —— 用户实测);
+//     真正的关闭由状态机在 5 分钟无录音后调 release_codec。
+//     两头都可能出错:不关 → 5V 功放常开耗电(用户反馈的根因);关早了 →
+//     每句话第一个字慢。所以这两件事都得钉住。
+static void test_codec_lifecycle(void) {
+    fake_reset();
+    ensure_init();
+    g_fake_codec_open_count = 0;
+    g_fake_codec_close_count = 0;
+
+    assert(audio_streamer_start() == ESP_OK);
+    assert(g_fake_codec_open_count == 1);
+    assert(g_fake_codec_open == 1);            // 录音中必须开着,否则无声
+    assert(wait_notify(1, 500));
+    audio_streamer_stop();
+    // 停流后保持热态:这条断言防的是"顺手把 close 加回 stop 里"的回归
+    assert(g_fake_codec_close_count == 0);
+    assert(g_fake_codec_open == 1);
+
+    // 紧接着的第二次会话复用已打开的 codec(同格式 → set_format 廉价复用),
+    // 这正是"连续口述零延迟"的落点
+    assert(audio_streamer_start() == ESP_OK);
+    audio_streamer_cancel();
+    assert(g_fake_codec_close_count == 0);     // 取消同样不关
+
+    // 空闲释放:这才是断电的唯一入口
+    audio_streamer_release_codec();
+    assert(g_fake_codec_close_count == 1);
+    assert(g_fake_codec_open == 0);
+    audio_streamer_release_codec();            // 幂等:重复调用不再计数
+    assert(g_fake_codec_close_count == 1);
+
+    // 采集进行中拒绝释放 —— 空闲计时到点与用户按下开录存在竞态,真关下去
+    // 会把正在录的音掐成静音
+    assert(audio_streamer_start() == ESP_OK);
+    assert(g_fake_codec_open == 1);
+    audio_streamer_release_codec();
+    assert(g_fake_codec_open == 1);            // 仍开着
+    assert(g_fake_codec_close_count == 1);     // 未新增
+    audio_streamer_stop();
+
+    // codec 打不开 → 拒绝开流(否则录出来是一片静音,用户以为设备坏了)
+    audio_streamer_release_codec();
+    g_fake_codec_open_fail = 1;
+    assert(audio_streamer_start() != ESP_OK);
+    assert(audio_streamer_active() == 0);
+    g_fake_codec_open_fail = 0;
+}
+
