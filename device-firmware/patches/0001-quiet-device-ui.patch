     // 失败注入用例放最前:s_ready 初始 false 时注入才真正触发 init 的创建路径
     // (成功 init 后幂等早返回,注入不再生效)。test_token_drops_stale 是首次
@@ -370,6 +424,7 @@ int main(void) {
     test_drain_with_token();
