+// --- codec 开关(2026-09-02 省电:开流时 open、停流时 close,断 5V 功放)---
+// 计数暴露给测试:一次会话应当恰好一开一关,不平衡就意味着功放被落在开着的
+// 状态(耗电)或提前关掉(录音无声)。
+int g_fake_codec_open_count = 0;
+int g_fake_codec_close_count = 0;
+int g_fake_codec_open_fail = 0;   // 非 0 → set_format 失败(测开流被拒路径)
+int g_fake_codec_open = 0;        // 当前是否处于打开态
+
+esp_err_t bsp_audio_set_format(uint32_t hz, uint8_t bits, uint8_t ch) {
+    (void)hz; (void)bits; (void)ch;
+    if (g_fake_codec_open_fail) return ESP_FAIL;
+    g_fake_codec_open_count++;
+    g_fake_codec_open = 1;
+    return ESP_OK;
+}
+
+esp_err_t bsp_audio_close(void) {
+    if (!g_fake_codec_open) return ESP_OK;   // 幂等,与真实实现一致
+    g_fake_codec_close_count++;
+    g_fake_codec_open = 0;
+    return ESP_OK;
+}
