+// 单节锂聚合物开路电压 → 剩余电量查表。
+//
+// 为什么不用 CW2017 自己的 SOC 寄存器:它返回 0xFE.E8(254.9%),不是 0xFF 的
+// "未就绪"而是【未标定】—— CW2017 必须写入与电芯匹配的 profile 才会输出合法
+// 百分比,而上游文档把"电池型号与容量、CW2017 profile"列在"尚未补充"清单里
+// (docs/AI_HARDWARE_DEVELOPMENT_GUIDE.md:419)。驱动原注释说"用芯片自带
+// Li-Poly profile"是错的:没有可用的出厂默认 profile,不写就永远出不了数。
+// 猜一份 profile 写进去比不写更糟(标定错的电量比没有电量更误导)。
+//
+// 曲线取通用 LiPo 放电特性。中段(3.6-3.9V)平坦是锂电的物理特性,那一段的
+// 估算天然粗糙 —— 这是电压法的固有限制,不是实现缺陷。真要准确 SOC 需要电芯
+// 参数 + 厂商 profile + 完整充放电验证,见上述文档同一行。
+// ⚠ 带负载时电压会被内阻拉低(录音瞬间尤其明显),所以这里的读数偏保守。
+static const struct { uint16_t mv; uint8_t pct; } LIPO_CURVE[] = {
+    { 4200, 100 }, { 4100,  94 }, { 4000,  85 }, { 3950,  76 },
+    { 3900,  67 }, { 3850,  58 }, { 3800,  48 }, { 3750,  38 },
+    { 3700,  29 }, { 3650,  20 }, { 3600,  13 }, { 3500,   6 },
+    { 3400,   2 }, { 3300,   0 },
+};
+
 int bsp_battery_soc(void) {
-    uint8_t b[2] = { 0 };
-    if (cw_read(CW_REG_SOC_H, b, 2) != 0) return -1;
-    int soc = b[0];                       // 高字节即整数百分比
-    if (soc > 100) return -1;             // 芯片未就绪时可能读到 0xFF
-    return soc;
+    const int mv = bsp_battery_mv();
+    if (mv < 0) return -1;
+    const size_t n = sizeof(LIPO_CURVE) / sizeof(LIPO_CURVE[0]);
+    if (mv >= LIPO_CURVE[0].mv) return 100;
+    if (mv <= LIPO_CURVE[n - 1].mv) return 0;
+    for (size_t i = 1; i < n; i++) {
+        if (mv >= LIPO_CURVE[i].mv) {
+            // 两点间线性插值,避免百分比跳变
+            const int hi_mv = LIPO_CURVE[i - 1].mv, lo_mv = LIPO_CURVE[i].mv;
+            const int hi_p = LIPO_CURVE[i - 1].pct, lo_p = LIPO_CURVE[i].pct;
+            return lo_p + (mv - lo_mv) * (hi_p - lo_p) / (hi_mv - lo_mv);
+        }
+    }
+    return 0;
 }
 
 int bsp_battery_mv(void) {
@@ -73,3 +103,18 @@ int bsp_battery_mv(void) {
     uint32_t raw = ((uint32_t)b[0] << 8 | b[1]) & 0x3FFF;   // 14bit
     return (int)((raw * 3125) / 10000);                     // raw * 312.5uV → mV
 }
