+void bsp_battery_dump(char *buf, size_t cap) {
+    if (!buf || cap == 0) return;
+    if (!s_dev) { snprintf(buf, cap, "cw2017: absent (init failed)\n"); return; }
+    uint8_t ver = 0, cfg = 0, soc[2] = { 0 }, vc[2] = { 0 };
+    int rv = cw_read(CW_REG_VERSION, &ver, 1);
+    int rc = cw_read(CW_REG_CONFIG, &cfg, 1);
+    int rs = cw_read(CW_REG_SOC_H, soc, 2);
+    int rw = cw_read(CW_REG_VCELL_H, vc, 2);
+    snprintf(buf, cap,
+             "cw2017: ver=%s0x%02X cfg=%s0x%02X soc=%s%02X.%02X vcell=%s0x%04X\n",
+             rv ? "ERR" : "", ver, rc ? "ERR" : "", cfg,
+             rs ? "ERR " : "", soc[0], soc[1],
+             rw ? "ERR " : "", (unsigned)(((uint32_t)vc[0] << 8 | vc[1]) & 0x3FFF));
+}
