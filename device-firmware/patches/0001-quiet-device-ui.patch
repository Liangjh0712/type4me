+// ---- 状态图标(纯色块拼像素画,不引字库) ----
+//
+// 每页一个大图标承担"这是什么状态"的表达,文字退到辅助位:一眼扫到形状比读
+// 单词快,且全大写英文短语在 240px 屏上既挤又硬。图标用 block 拼,复用既有
+// 像素语言,不额外占 flash(内嵌字库要几十 KB,只为几个词不值)。
+
+// 麦克风:胶囊头 + 支架 + 底座。LISTENING 用。
+static void icon_mic(lv_obj_t *parent, int cx, int cy, uint32_t color)
+{
+    block(parent, cx - 9, cy - 22, 18, 26, color);        // 头(胶囊主体)
+    block(parent, cx - 11, cy - 14, 2, 12, color);        // 左护弧
+    block(parent, cx + 9, cy - 14, 2, 12, color);         // 右护弧
+    block(parent, cx - 11, cy - 2, 22, 2, color);         // 弧底
+    block(parent, cx - 2, cy, 4, 8, color);               // 支架
+    block(parent, cx - 10, cy + 8, 20, 3, color);         // 底座
+}
+
+// 三点省略:识别中。中间点用重色,读作"正在处理"而不是静止装饰。
+static void icon_dots(lv_obj_t *parent, int cx, int cy, uint32_t color)
+{
+    block(parent, cx - 22, cy, 10, 10, color);
+    block(parent, cx - 5, cy, 10, 10, color);
+    block(parent, cx + 12, cy, 10, 10, color);
+}
+
+// 声波:麦克风两侧的弧,表示在收音。
+static void icon_waves(lv_obj_t *parent, int cx, int cy, uint32_t color)
+{
+    block(parent, cx - 30, cy - 6, 3, 12, color);
+    block(parent, cx - 38, cy - 11, 3, 22, color);
+    block(parent, cx + 27, cy - 6, 3, 12, color);
+    block(parent, cx + 35, cy - 11, 3, 22, color);
+}
+
