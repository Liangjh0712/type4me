@@ -193,6 +193,34 @@ static int cmd_time(int argc, char **argv)
     return 1;
 }
 
+// ---- owner:待机页名牌上的名字(存 NVS,重启生效) ----
+static int cmd_owner(int argc, char **argv)
+{
+    if (argc == 1) {
+        char name[NVS_OWNER_MAX] = { 0 };
+        nvs_settings_get_owner(name, sizeof(name));
+        out("owner: %s\n", name[0] ? name : "(unset)");
+        return 0;
+    }
+    if (argc == 3 && strcmp(argv[1], "set") == 0) {
+        if (strlen(argv[2]) >= NVS_OWNER_MAX) {
+            out("owner set: too long (max %d chars)\n", NVS_OWNER_MAX - 1);
+            return 1;
+        }
+        esp_err_t e = nvs_settings_set_owner(argv[2]);
+        // 名牌在建页时读一次 NVS,所以要重启才换 —— 说清楚,免得以为没生效。
+        out("owner set: %s (reboot to apply)\n", e == ESP_OK ? "ok" : esp_err_to_name(e));
+        return e == ESP_OK ? 0 : 1;
+    }
+    if (argc == 2 && strcmp(argv[1], "clear") == 0) {
+        esp_err_t e = nvs_settings_set_owner(NULL);
+        out("owner clear: %s (reboot to apply)\n", e == ESP_OK ? "ok" : esp_err_to_name(e));
+        return e == ESP_OK ? 0 : 1;
+    }
+    out("usage: owner | owner set <name> | owner clear\n");
+    return 1;
+}
+
 // ---- log:导出 USB 模式日志环(REPL 模式下日志直接上屏,环为空) ----
 // 可选 <offset>:SYS_RESP 载荷上限 2048B(USB_RESP_MAX),环(16KB)超限时
 // 首块恰在中间截断。`log 2048` / `log 4096` … 按游标分多次取回全量 ——
@@ -333,6 +361,7 @@ static int cmd_factory(int argc, char **argv)
 static const struct { const char *name; esp_console_cmd_func_t fn; } s_cmds[] = {
     { "log",     cmd_log },
     { "time",    cmd_time },
+    { "owner",   cmd_owner },
     { "st",      cmd_st },
     { "rst",     cmd_rst },
     { "reboot",  cmd_reboot },
@@ -417,6 +446,7 @@ esp_err_t console_cmds_register(void)
     reg("st", "系统状态一览(双链路/MTU/掉帧/堆)", NULL, cmd_st);
     reg("rst", "复位原因(无线自动重启诊断)", NULL, cmd_rst);
     reg("time", "校时:time | time set <epoch> | time tz <±hh>", NULL, cmd_time);
+    reg("owner", "待机页名字:owner | owner set <name> | owner clear", NULL, cmd_owner);
     reg("reboot", "重启设备", NULL, cmd_reboot);
     reg("factory", "清空 NVS 并重启", NULL, cmd_factory);
     return ESP_OK;
