+void bsp_button_release_for_sleep(void) {
+    // 顺序是本函数存在的全部理由,别调换(见头文件注释里的两次真机踩坑):
+    // ① 停扫描 —— iot_button 的 5ms 定时器还在跑的时候动引脚,下一次采样
+    //    踩空,真机是 int_wdt 复位而不是报错。
+    iot_button_stop();
+    for (int i = 0; i < BSP_BTN_COUNT; i++) {
+        if (s_btn[i]) { iot_button_delete(s_btn[i]); s_btn[i] = NULL; }
+    }
+    // ② 释放 ADC 单元 —— 不释放的话引脚仍被登记为模拟功能。
+    if (s_cali) {
+#if ADC_CALI_SCHEME_CURVE_FITTING_SUPPORTED
+        adc_cali_delete_scheme_curve_fitting(s_cali);
+#endif
+        s_cali = NULL;
+    }
+    if (s_adc) { adc_oneshot_del_unit(s_adc); s_adc = NULL; }
+    // ③ 引脚回到数字输入。上拉靠板上外部 10k(bsp_pins.h 电路图),不开内部的。
+    gpio_reset_pin((gpio_num_t)BSP_BTN_GPIO_NUM);
+    gpio_set_direction((gpio_num_t)BSP_BTN_GPIO_NUM, GPIO_MODE_INPUT);
+    gpio_set_pull_mode((gpio_num_t)BSP_BTN_GPIO_NUM, GPIO_FLOATING);
+    ESP_LOGI(TAG, "按键已释放,引脚回到数字输入(深睡眠准备)");
+}
